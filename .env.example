# QuoteWise local development environment configuration.
#
# Copy to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets.
# Every value below is a DEVELOPMENT-ONLY placeholder.

# --- Runtime mode and logging (shared by the Go API and AI service) ---
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- PostgreSQL (pgvector image; dev-only credentials) ---
# 5432 is commonly occupied by a native PostgreSQL service on this
# machine; 15432 avoids the conflict.
POSTGRES_USER=quotewise
POSTGRES_PASSWORD=quotewise-dev
POSTGRES_DB=quotewise
POSTGRES_PORT=15432

# --- Redis (optional cache; dev-only) ---
REDIS_PORT=6379

# --- MinIO object storage (dev-only credentials; >= 8 characters) ---
MINIO_ROOT_USER=quotewise-dev
MINIO_ROOT_PASSWORD=quotewise-dev
MINIO_API_PORT=9000

# --- Service ports (host side of Docker mappings) ---
# 8080 is commonly occupied on this machine; 18069 avoids the conflict.
HTTP_PORT=18069
AI_SERVICE_PORT=8000
WEB_PORT=5173

# --- Authentication (Milestone 2) ---
SESSION_TTL=168h
AUTH_RATE_LIMIT_PER_MINUTE=10
RUN_MIGRATIONS=true

# --- Endpoints for running apps NATIVELY on the host ---
# (Inside Docker Compose these hosts are overridden with service names:
#  postgres, ai-service, api.)
DATABASE_URL=postgresql://quotewise:quotewise-dev@localhost:15432/quotewise
AI_SERVICE_URL=http://localhost:8000
